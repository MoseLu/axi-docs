# 文档库根目录路径（本地 Obsidian vault 等）
OBSIDIAN_PATH=./docs

# Blinko 服务地址和认证 Token
BLINKO_URL=http://localhost:1111
BLINKO_TOKEN=

# Anthropic API（用于 AI 文档分析）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
AI_MODEL=claude-3-5-haiku-20241022

# HTTP 服务绑定地址（仅本机: 127.0.0.1，或所有网卡: 0.0.0.0）
BIND_ADDRESS=127.0.0.1

# MCP HTTP 服务访问 Token（留空则自动生成并保存至 .mcp-token）
MCP_AUTH_TOKEN=

# 允许跨域请求的来源（逗号分隔，留空则开发模式允许所有）
# 示例: ALLOWED_ORIGINS=https://your-domain.com,http://localhost:3005
ALLOWED_ORIGINS=

# Vite 开发服务器端口
VITE_PORT=3005
