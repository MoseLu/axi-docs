NODE_ENV=production
MCP_HTTP_PORT=3010
BIND_ADDRESS=0.0.0.0

# Primary knowledge root exposed as the default "obsidian" source
OBSIDIAN_PATH=/root/.hermes/knowledge

# Optional Blinko integration
BLINKO_URL=http://127.0.0.1:1111
BLINKO_TOKEN=

# MiniMax-compatible analysis
MCP_ANTHROPIC_API_KEY=
AI_MODEL=claude-3-5-haiku-20241022

# Persistent token for /mcp HTTP access
MCP_AUTH_TOKEN=

# Extra Hermes-aware local sources
INFO_HUB_EXTRA_SOURCES_JSON=[{"id":"hermes-system","name":"Hermes System","path":"/root/.hermes/memories","type":"local","enabled":true,"description":"Hermes 长期记忆与系统文档","icon":"folder"},{"id":"hermes-home","name":"Hermes Home","path":"/root/.hermes","type":"local","enabled":true,"description":"Hermes 全局文档与技能说明","icon":"folder"}]
