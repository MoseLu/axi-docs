# Info-Hub 环境变量配置

# Vite API 基础路径
VITE_API_BASE=/docs/api

# ======================================
# Blinko 配置（可选）
# ======================================
# Blinko API 地址
# BLINKO_URL=http://localhost:3006

# Blinko API Token
# 优先级：BLINKO_TOKEN 环境变量 > 空字符串（Blinko 关闭认证时）
# Docker 部署：在 docker-compose.yml 或 .env 文件中设置此值
# 本地开发：如 Blinko 开启认证，配置此值；如关闭认证，留空即可
# BLINKO_TOKEN=your-blinko-api-token

# ======================================
# Obsidian 配置（可选）
# ======================================
# Obsidian Vault 路径
# OBSIDIAN_PATH=F:/docs/obsidian/
