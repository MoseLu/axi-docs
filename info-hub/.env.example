# Info-Hub 环境变量配置

# ======================================
# 基础配置
# ======================================
# Vite API 基础路径
VITE_API_BASE=/api

# ======================================
# Obsidian 配置
# ======================================
# Obsidian Vault 路径
OBSIDIAN_PATH=./docs

# 额外知识源（JSON 数组，可追加 Hermes/system 等本地目录）
# 示例:
# INFO_HUB_EXTRA_SOURCES_JSON=[{"id":"hermes-system","name":"Hermes System","path":"/root/.hermes/memories","type":"local","enabled":true,"description":"Hermes 长期记忆与系统文档","icon":"folder"}]
INFO_HUB_EXTRA_SOURCES_JSON=

# ======================================
# Blinko 配置
# ======================================
# Blinko 服务地址
BLINKO_URL=http://localhost:1111

# Blinko API Token
# 优先级：BLINKO_TOKEN 环境变量 > 空字符串（Blinko 关闭认证时）
# Docker 部署：在 docker-compose.yml 或 .env 文件中设置此值
# 本地开发：如 Blinko 开启认证，配置此值；如关闭认证，留空即可
BLINKO_TOKEN=

# ======================================
# Anthropic AI 配置（用于 AI 文档分析）
# ======================================
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
AI_MODEL=claude-3-5-haiku-20241022

# ======================================
# MCP 服务器配置
# ======================================
# HTTP 服务绑定地址（仅本机: 127.0.0.1，或所有网卡: 0.0.0.0）
BIND_ADDRESS=127.0.0.1

# MCP HTTP 服务访问 Token（留空则自动生成并保存至 .info-hub-token）
MCP_AUTH_TOKEN=

# 允许跨域请求的来源（逗号分隔，留空则开发模式允许所有）
# 示例: ALLOWED_ORIGINS=https://your-domain.com,http://localhost:3005
ALLOWED_ORIGINS=

# Vite 开发服务器端口
VITE_PORT=3005
