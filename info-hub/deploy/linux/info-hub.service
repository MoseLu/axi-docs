[Unit]
Description=Info Hub HTTP and MCP service
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/.hermes/apps/info-hub
EnvironmentFile=/root/.hermes/apps/info-hub/.env.server
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash -lc 'npm run mcp:http'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
